{
  "name": "azd-rest",
  "version": "0.4.6",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "scripts": {
    "test": "pnpm run test:cli",
    "test:cli": "pnpm run test:cli:unit && pnpm run test:cli:integration",
    "test:cli:unit": "cd cli && go test -v -short ./src/...",
    "test:cli:integration": "cd cli && go test -v -tags=integration -timeout=10m ./src/...",
    "test:web": "pnpm --filter azd-rest-web test",
    "test:all": "pnpm run test:cli && pnpm run test:web"
  },
  "devDependencies": {}
}
