{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["node"],
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "astro",
    "resolveJsonModule": true,
    "allowJs": true
  },
  "include": [".astro/types.d.ts", "src/**/*", "tests/**/*.ts", "*.ts"],
  "exclude": ["dist"]
}
